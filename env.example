# Copy this file to .env and fill in ONE key. Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
# For Claude instead:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here
# For OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# Optional: LLM_MODEL=model-name
# Retrieval-only (no key needed): LLM_PROVIDER=none
